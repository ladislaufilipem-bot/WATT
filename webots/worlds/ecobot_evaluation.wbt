#VRML_SIM R2023b utf8

WorldInfo {
  coordinateSystem "NUE"
  title "Ecobot Evaluation - Garrafa PET para Lixeira"
  info ["Ecobot Evaluation: Generalization test", "Garrafa em posições variadas, sem obstáculos"]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction 0.8
      bounce 0.05
      bounceVelocity 0.1
    }
    ContactProperties {
      material1 "gripper"
      material2 "bottle"
      coulombFriction 1.2
      bounce 0.0
      bounceVelocity 0.0
      forceDependentSlip 0.0
    }
  ]
}

Viewpoint {
  position 2 2 3
  orientation 1 0 0 -0.7
  description "Evaluation View"
}

# ============================================================
# CHÃO
# ============================================================
Solid {
  translation 0 -0.025 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.3 0.4 0.3
        }
      }
      geometry Box {
        size 5 0.05 5
      }
    }
  ]
  boundingObject Box {
    size 5 0.05 5
  }
  physics Physics {
    mass 0.0
  }
}

# ============================================================
# ECOBOT
# ============================================================
Ecobot {
  translation 0 0.1 0
  name "ECOBOT"
  controller "ppo_agent"
}

# ============================================================
# GARRAFA PET - Posição será randomizada pelo supervisor
# ============================================================
DEF BOTTLE Solid {
  translation 1.5 0.12 0.5
  name "BOTTLE"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.0 0.4 0.8
          transparency 0.15
          specularColor 0.5 0.5 0.5
          shininess 0.7
        }
      }
      geometry Cylinder {
        radius 0.032
        height 0.22
      }
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.0 0.3 0.6
          transparency 0.15
        }
      }
      geometry Cylinder {
        radius 0.013
        height 0.035
      }
      translation 0 0.127 0
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.2 0.4
        }
      }
      geometry Cylinder {
        radius 0.015
        height 0.015
      }
      translation 0 0.145 0
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1.0 1.0 1.0
        }
      }
      geometry Cylinder {
        radius 0.033
        height 0.08
      }
      translation 0 -0.02 0
    }
  ]
  boundingObject Cylinder {
    radius 0.035
    height 0.24
  }
  physics Physics {
    mass 0.025
    centerOfMass 0 0.11 0
  }
}

# ============================================================
# LIXEIRA
# ============================================================
DEF TRASH_BIN Solid {
  translation -1.5 0.35 -0.5
  name "TRASH_BIN"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.2 0.5 0.2
        }
      }
      geometry Cylinder {
        radius 0.2
        height 0.7
        openEnd TRUE
      }
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.3 0.1
        }
      }
      geometry Cylinder {
        radius 0.22
        height 0.05
      }
      translation 0 -0.35 0
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.0 0.3 0.0
        }
      }
      geometry Cylinder {
        radius 0.21
        height 0.03
      }
      translation 0 0.35 0
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1.0 1.0 1.0
          emissionColor 0.2 0.2 0.2
        }
      }
      geometry Box {
        size 0.15 0.01 0.15
      }
      translation 0.18 0.1 0.18
    }
  ]
  boundingObject Cylinder {
    radius 0.25
    height 0.75
  }
  physics Physics {
    mass 0.0
  }
}

# ============================================================
# SUPERVISOR (com randomização de posição da garrafa)
# ============================================================
Supervisor {
  name "SUPERVISOR"
  controller "supervisor"
}

# ============================================================
# LUZES
# ============================================================
DirectionalLight {
  direction 0 -1 -0.5
  intensity 0.8
  color 1 1 1
  ambientIntensity 0.3
  castShadows TRUE
}

PointLight {
  location 0 2 0
  intensity 0.5
  radius 4
  color 1 1 1
}