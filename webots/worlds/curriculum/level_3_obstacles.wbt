Solid {
  translation 0.8 0.25 -0.3
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.4 0.4 0.5 } } geometry Cylinder { radius 0.12 height 0.5 } } ]
  boundingObject Cylinder { radius 0.12 height 0.5 }
