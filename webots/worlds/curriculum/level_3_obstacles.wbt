Solid {
  translation -0.5 0.15 0.8
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.5 0.3 0.2 } } geometry Box { size 0.25 0.4 0.25 } } ]
  boundingObject Box { size 0.25 0.4 0.25 }
  physics Physics { mass 0.0 }
}
