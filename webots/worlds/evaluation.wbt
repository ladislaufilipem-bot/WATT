#VRML_SIM R2023b utf8

WorldInfo {
  coordinateSystem "NUE"
  title "PPO Evaluation World"
  info ["PPO Evaluation Environment", "Auto-generated"]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction 1.0
      bounce 0.0
      bounceVelocity 0.1
    }
  ]
}

Viewpoint {
  position 0 3 5
  orientation 1 0 0 -0.6
  description "Evaluation View"
}

# Ground plane with some variation
Solid {
  translation 0 0 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.4 0.6 0.4
        }
      }
      geometry Box {
        size 20 0.1 20
      }
    }
  ]
  boundingObject Box {
    size 20 0.1 20
  }
  physics Physics {
    mass 0.0
  }
}

# Target marker
Transform {
  translation 5 0.05 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.0 1.0 0.0
          transparency 0.5
        }
      }
      geometry Cylinder {
        radius 0.5
        height 0.1
      }
    }
  ]
}

# PPO Robot
PPOWalkerRobot {
  translation 0 0.5 0
  name "PPO_ROBOT"
  controller "ppo_agent"
}

# Supervisor
Supervisor {
  name "SUPERVISOR"
  controller "supervisor"
}