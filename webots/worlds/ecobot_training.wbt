# ============================================================
# SUPERVISOR
# ============================================================
Supervisor {
  name "SUPERVISOR"
  controller "supervisor"
}

# ============================================================
# LUZES
# ============================================================
DirectionalLight {
  direction 0 -1 -0.5
  intensity 0.8
  color 1 1 1
  ambientIntensity 0.3
  castShadows TRUE
}

PointLight {
  location 0 2 0
  intensity 0.5
  radius 4
  color 1 1 1
}